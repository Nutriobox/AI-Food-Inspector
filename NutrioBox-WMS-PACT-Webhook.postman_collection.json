{
  "info": {
    "name": "NutrioBox WMS - PACT Webhook",
    "description": "Real-time factory-stage events from PACT into the NutrioBox app (KDS / AI Food Inspector).\n\nEndpoint: POST {{base_url}}/api/vouchers/pact-webhook\nAuth: header  Authorization: Bearer {{token}}  OR  x-api-key: {{token}}\nBody: JSON, one call per event, tagged with an \"event\" field.\nEvents: PMR, STOCK_RECEIPT, ISSUE_TO_PRODUCTION, WIP, FG_RECEIPT, SECONDARY.\n\nSet collection variables base_url and token. Sample field names are a template - align them with the field spec before go-live.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://aifoodinspector.nutriobox.com",
      "type": "string"
    },
    {
      "key": "token",
      "value": "ntbx_whk_587231a06c77c733d51e1326f3d4212dd0db2936d3948e2e",
      "type": "string"
    }
  ],
