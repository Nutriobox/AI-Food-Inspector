[Unit]
Description=Nutriobox load-cell weight service
After=network.target

[Service]
Type=simple
# Path + user for the Nutriobox CM4 machine (admin user).
WorkingDirectory=/home/admin/pi-weight-service
ExecStart=/usr/bin/python3 /home/admin/pi-weight-service/weight_server.py
# No HX711_DT/SCK here on purpose -> it uses the auto-detected pins in hx711_pins.json
Environment=WEIGHT_PORT=8765
Restart=always
RestartSec=2
User=admin

[Install]
WantedBy=multi-user.target
